# Required for live PDF-to-fact extraction. The app still runs in demo mode without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated fallback models, tried in order on transient failures only.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Waits between full chain retries during saturation; empty means one round.
FACT_KNOWLEDGE_RETRY_DELAYS=60
